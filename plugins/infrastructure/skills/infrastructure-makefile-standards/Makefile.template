# GNU Make template for a Docker-first development repository.

SHELL := /bin/sh
.DEFAULT_GOAL := help
.DELETE_ON_ERROR:

.PHONY: help config up down restart logs status watch \
        test lint format check validate build clean info version

PROJECT      ?= example-service
VERSION      ?= dev
COMPOSE      ?= docker compose
COMPOSE_FILE ?= compose.yaml
DEV_SERVICE  ?= app
BUILD_DIR    ?= dist
SAFE_CLEAN_DIRS ?= dist

# Keep project commands empty until project.mk supplies truthful implementations.
CMD_DEV      ?=
CMD_TEST     ?=
CMD_LINT     ?=
CMD_FORMAT   ?=
CMD_BUILD    ?=

-include project.mk

# Recursive expansion keeps later project.mk and command-line overrides visible.
COMPOSE_CMD = $(COMPOSE) -f $(COMPOSE_FILE)

# $(call require-command,CMD_NAME) fails before an undefined operation can pass.
define require-command
	@test -n "$(strip $($(1)))" || { \
		printf '%s\n' "$(1) is not configured; set it in project.mk"; \
		exit 2; \
	}
endef

help: ## Utility: Show available commands
	@awk 'BEGIN { FS = ":.*## " } \
		/^[A-Za-z0-9_.-]+:.*## / { printf "  %-16s %s\n", $$1, $$2 }' \
		$(MAKEFILE_LIST)

config: ## Setup: Validate Compose configuration
	@$(COMPOSE_CMD) config --quiet

up: config ## Setup: Start the development stack
	@$(COMPOSE_CMD) up -d

down: ## Setup: Stop the development stack
	@$(COMPOSE_CMD) down

restart: ## Setup: Restart existing services
	@$(COMPOSE_CMD) restart

logs: ## Logs: Follow service logs
	@$(COMPOSE_CMD) logs -f

status: ## Logs: Show service status
	@$(COMPOSE_CMD) ps

watch: ## Development: Run the interactive development command
	$(call require-command,CMD_DEV)
	@$(COMPOSE_CMD) exec $(DEV_SERVICE) $(CMD_DEV)

test: ## Quality: Run focused tests
	$(call require-command,CMD_TEST)
	@$(COMPOSE_CMD) exec -T $(DEV_SERVICE) $(CMD_TEST)

lint: ## Quality: Run the linter
	$(call require-command,CMD_LINT)
	@$(COMPOSE_CMD) exec -T $(DEV_SERVICE) $(CMD_LINT)

format: ## Quality: Format project files
	$(call require-command,CMD_FORMAT)
	@$(COMPOSE_CMD) exec -T $(DEV_SERVICE) $(CMD_FORMAT)

check: ## Quality: Run the fast quality checks
	+@$(MAKE) lint
	+@$(MAKE) test

build: ## Build: Build the project artifact
	$(call require-command,CMD_BUILD)
	@$(COMPOSE_CMD) exec -T $(DEV_SERVICE) $(CMD_BUILD)

validate: ## Quality: Run the complete local validation contract
	+@$(MAKE) config
	+@$(MAKE) check
	+@$(MAKE) build

clean: ## Maintenance: Remove generated build output
ifeq ($(strip $(BUILD_DIR)),)
	@printf '%s\n' "refusing empty BUILD_DIR"
	@exit 2
else ifneq ($(filter /% . .. .% %/%,$(BUILD_DIR)),)
	@printf '%s\n' "refusing unsafe BUILD_DIR shape"
	@exit 2
else ifeq ($(filter $(BUILD_DIR),$(SAFE_CLEAN_DIRS)),)
	@printf '%s\n' "refusing BUILD_DIR outside SAFE_CLEAN_DIRS"
	@exit 2
else
	@if [ -e "./$(BUILD_DIR)" ]; then rm -r -- "./$(BUILD_DIR)"; fi
endif

info: ## Logs: Show non-sensitive project configuration
	@printf '%s\n' \
		"Project: $(PROJECT)" \
		"Version: $(VERSION)" \
		"Compose file: $(COMPOSE_FILE)"

version: ## Logs: Show project version
	@printf '%s\n' "$(VERSION)"
