# Project Makefile (Docker-first, grouped help)
.PHONY: help up down restart logs watch \
        build test lint format check \
        deploy release publish \
        clean clean-all \
        status info version

.DEFAULT_GOAL := help

# -------- Color Aliases --------
h1 := \033[1;36m
h2 := \033[1;34m
b  := \033[1;32m
p  := \033[1;33m
r  := \033[1;31m
reset := \033[0m

# -------- Variables (override in project.mk) --------
PROJECT       ?= example-project
VERSION       ?= 0.1.0

COMPOSE       ?= docker compose
COMPOSE_FILE  ?= compose.yaml
DEV_SERVICE   ?= app

CMD_DEV       ?=
CMD_BUILD     ?=
CMD_TEST      ?=
CMD_LINT      ?=
CMD_FORMAT    ?=
CMD_DEPLOY    ?=
CMD_RELEASE   ?=
CMD_PUBLISH   ?=
CMD_CLEAN     ?=
CMD_CLEAN_ALL ?=

define require-command
$(if $(strip $($(1))),,@printf '%s\n' '$(1): configure a project-owned command in project.mk' >&2; exit 2)
endef

# -------- Help --------
help: ## Utility: Show grouped help
	@printf '\n%b\n' "$(h1)=====================================================$(reset)"
	@printf '%b\n' "$(h2)   $(PROJECT) v$(VERSION) — Available Commands$(reset)"
	@printf '%b\n\n' "$(h1)=====================================================$(reset)"
	@awk 'BEGIN{group_order[1]="Setup";group_order[2]="Development";group_order[3]="Quality";group_order[4]="Build";group_order[5]="Maintenance";group_order[6]="Logs";title["Setup"]="Setup & Config";title["Development"]="Development";title["Quality"]="Quality";title["Build"]="Build & Deploy";title["Maintenance"]="Maintenance";title["Logs"]="Logs & Info"} /^[a-zA-Z0-9_.-]+:.*## [^:]+: /{name=$$0;sub(/:.*/,"",name);annotation=$$0;sub(/^.*## /,"",annotation);group=annotation;sub(/:.*/,"",group);description=annotation;sub(/^[^:]+:[[:space:]]*/,"",description);if(!(name in seen)){sequence[++count]=name;seen[name]=1};groups[name]=group;descriptions[name]=description} END{for(g=1;g<=6;g++){current=group_order[g];printf "\n$(h2)%s$(reset)\n",title[current];for(i=1;i<=count;i++){name=sequence[i];if(groups[name]==current){printf "  $(b)%-18s$(reset) %s\n",name,descriptions[name]}}}}' $(MAKEFILE_LIST)

# -------- Setup --------
up: ## Setup: Start Docker stack (compose)
	@$(COMPOSE) -f $(COMPOSE_FILE) up -d

down: ## Setup: Stop Docker stack (compose)
	@$(COMPOSE) -f $(COMPOSE_FILE) down

restart: ## Setup: Restart Docker stack (compose)
	@$(COMPOSE) -f $(COMPOSE_FILE) down
	@$(COMPOSE) -f $(COMPOSE_FILE) up -d

logs: ## Logs: Tail Docker stack logs
	@$(COMPOSE) -f $(COMPOSE_FILE) logs -f

watch: ## Development: Run app in watch mode (container)
	$(call require-command,CMD_DEV)
	@$(COMPOSE) -f $(COMPOSE_FILE) exec $(DEV_SERVICE) $(CMD_DEV)

# -------- Quality --------
test: ## Quality: Run tests
	$(call require-command,CMD_TEST)
	@$(CMD_TEST)

lint: ## Quality: Run linter
	$(call require-command,CMD_LINT)
	@$(CMD_LINT)

format: ## Quality: Format code
	$(call require-command,CMD_FORMAT)
	@$(CMD_FORMAT)

check: lint test ## Quality: Run lint + test
	@echo "$(b)checks: ok$(reset)"

# -------- Build & Deploy --------
build: ## Build: Build project
	$(call require-command,CMD_BUILD)
	@$(CMD_BUILD)

deploy: ## Build: Deploy project
	$(call require-command,CMD_DEPLOY)
	@$(CMD_DEPLOY)

release: ## Build: Create release
	$(call require-command,CMD_RELEASE)
	@$(CMD_RELEASE)

publish: ## Build: Publish artefact
	$(call require-command,CMD_PUBLISH)
	@$(CMD_PUBLISH)

# -------- Maintenance --------
clean: ## Maintenance: Clean build artefacts
	$(call require-command,CMD_CLEAN)
	@$(CMD_CLEAN)

clean-all: ## Maintenance: Full clean (artefacts + deps)
	$(call require-command,CMD_CLEAN_ALL)
	@$(CMD_CLEAN_ALL)

# -------- Logs & Info --------
status: ## Logs: Show status
	@$(COMPOSE) -f $(COMPOSE_FILE) ps

info: ## Logs: Show info
	@echo "Project: $(PROJECT)"
	@echo "Version: $(VERSION)"
	@echo "Compose: $(COMPOSE) -f $(COMPOSE_FILE)"

version: ## Logs: Show version
	@echo "$(VERSION)"

# Load project command hooks, help annotations, and additional targets last.
-include project.mk
