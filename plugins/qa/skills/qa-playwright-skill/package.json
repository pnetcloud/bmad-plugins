{
  "name": "playwright-skill",
  "version": "4.1.0",
  "description": "Explicit, review-first Playwright browser automation runner and helper library",
  "author": "lackeyjb",
  "main": "run.js",
  "scripts": {
    "install-dependencies": "npm install --ignore-scripts --no-package-lock",
    "install-browser": "playwright install chromium",
    "setup": "npm run install-dependencies && npm run install-browser",
    "install-all-browsers": "playwright install chromium firefox webkit",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "playwright",
    "automation",
    "browser-testing",
    "web-automation",
    "claude-skill",
    "general-purpose"
  ],
  "dependencies": {
    "@playwright/test": "1.61.0",
    "playwright": "1.61.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
